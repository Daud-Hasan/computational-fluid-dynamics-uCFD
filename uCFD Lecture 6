# 2D Linear Advection with FTUS Scheme
We solve:
\begin{equation}
\frac{\partial u}{\partial t} = -U \frac{\partial u}{\partial x} -V \frac{\partial u}{\partial y}
\end{equation}

import numpy as np
import matplotlib.pyplot as plt
import matplotlib.animation as animation
from matplotlib import cm

# Grid setup
nx = 33
ny = 33
Lx = 1.0
Ly = 1.0

x = np.linspace(0, Lx, nx)
dx = x[1] - x[0]

y = np.linspace(0, Ly, ny)
dy = y[1] - y[0]

xx, yy = np.meshgrid(x, y)

# Initial condition
wx = 2.0 * np.pi
wy = 2.0 * np.pi
u0 = lambda x, y: np.sin(wx * x) * np.sin(wy * y)

U = 1.0
V = 1.0

# Stability condition (CFL)
dt = 0.95 / (abs(U) / dx + abs(V) / dy)

t = 0.0
tend = 2.0

Crx = U * dt / dx
Cry = V * dt / dy

# Setup solution array with ghost cells
sol = []
u = np.zeros([ny + 2, nx + 2])
u[1:-1, 1:-1] = u0(xx, yy)

# Set initial periodic boundary conditions
u[:, 0] = u[:, -3]
u[:, -1] = u[:, 2]
u[0, :] = u[-3, :]
u[-1, :] = u[2, :]
sol.append(u)

# Time advancement loop
while t < tend:
    un = sol[-1]
    unew = un.copy()
    
    # Upwind spatial discretization for U > 0 and V > 0
    unew[1:-1, 1:-1] = (
        un[1:-1, 1:-1]
        - Crx * (un[1:-1, 1:-1] - un[1:-1, :-2])
        - Cry * (un[1:-1, 1:-1] - un[:-2, 1:-1])
    )
    
    # Update periodic boundary conditions
    unew[:, 0] = unew[:, -3]
    unew[:, -1] = unew[:, 2]
    unew[0, :] = unew[-3, :]
    unew[-1, :] = unew[2, :]
    
    sol.append(unew)
    t += dt

# Define contour levels explicitly
levs = np.linspace(-1.0, 1.0, 50)

fig, ax = plt.subplots()

def animate(i):
    ax.clear()
    cont = ax.contourf(
        xx, yy,
        sol[i][1:-1, 1:-1],
        cmap=cm.inferno,
        levels=levs,
        vmax=1.0,
        vmin=-1.0
    )
    ax.set_xlim(0, 1)
    ax.set_ylim(0, 1)
    ax.set_title(f"Time: {i * dt:.2f} s")
    return cont

ani = animation.FuncAnimation(
    fig,
    animate,
    frames=len(sol),
    interval=35,
    blit=False,
    repeat_delay=1000
)


ani
