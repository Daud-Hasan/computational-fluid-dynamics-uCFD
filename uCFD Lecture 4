# Solve the 1D unsteady diffusion equation with the FTCS scheme
we solve
\begin{equation}
\frac{\partial u}{\partial t} = \mu \frac{\partial ^2 u}{\partial x^2}
\end{equation}
subject to $u(x,t=0) = U_0(x)$ and boundary conditions $u(x=0, t) = u(x=L,t) = 0.0$

import numpy as np
%matplotlib inline
%config InlineBackend.figure_format = 'svg'
import matplotlib.pyplot as plt

import matplotlib.animation as animation
plt.rcParams['animation.html'] = 'jshtml'

# define number of grid points in space
n = 101
L = 1.0 # length of the domain
x = np.linspace(0,L,n)
dx = x[1] - x[0]

# define our initial condition
U0 = np.sin(2.0*np.pi*x)
plt.plot(x,U0,'-o',markersize=3)
plt.grid()

# it is time to define time
dt = 1e-3 # s
tend = 5.0 # s
mu = 1e-2 # thermal diffusivity m2/s

sol = [] # container that will contain the solution in time
sol.append(U0)
t = 0.0 # t0 we're starting from t = 0

# we are ready to advance in time
while t < tend:
    un = sol[-1] # grab the solution at time level n
    # create a new array for the solution at n+1 (np1)
    unp1 = np.zeros_like(un)
    # compute un+1 at the interior points only!
    unp1[1:-1] = un[1:-1] + mu*dt/dx/dx * (un[:-2] -2.0*un[1:-1] + un[2:])
    # set the bcs
    unp1[0] = 0.0
    unp1[-1] = 0.0
    sol.append(unp1)
    t += dt

ims = []
fig = plt.figure(figsize = [5,4],dpi = 100)
plt.grid()

i = 0
for solution in sol:
    if (i%50==0): # output frequency for frames
        im = plt.plot(x,solution,'k-',animated=True)
        plt.ylim(-1.1,1.1)
        ims.append(im)
    i+=1
ani = animation.ArtistAnimation(fig, ims, interval=35, blit=True,repeat_delay=1000)
ani
